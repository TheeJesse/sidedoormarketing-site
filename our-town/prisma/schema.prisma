generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  city          String?
  state         String?
  zip           String?
  bio           String?
  profilePhoto  String?
  radius        Int      @default(25)
  // contactMethod: "email" | "phone" | "both"
  contactMethod String?
  // The value shown publicly (email address or phone number)
  contactValue  String?
  emailVerified              DateTime?
  verificationToken          String?
  verificationTokenExpiresAt DateTime?
  onboardingComplete         Boolean  @default(false)
  isApproved    Boolean  @default(true)
  isHidden      Boolean  @default(false)
  isAdmin       Boolean  @default(false)
  plan          String   @default("free")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  offers     Offer[]
  needs      Need[]
  reviews    Review[]
  matchesAsA Match[]  @relation("MatchUserA")
  matchesAsB Match[]  @relation("MatchUserB")
}

model Category {
  id     String  @id @default(cuid())
  name   String  @unique
  icon   String? // emoji representing this category
  offers Offer[]
  needs  Need[]
}

model Offer {
  id          String    @id @default(cuid())
  userId      String
  title       String
  categoryId  String?
  description String?
  createdAt   DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
}

model Need {
  id          String    @id @default(cuid())
  userId      String
  title       String
  categoryId  String?
  description String?
  createdAt   DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
}

// Placeholder for trust signals — expandable in future
model Review {
  id        String   @id @default(cuid())
  userId    String
  // "trusted_trader" | "quick_responder" | "community_builder"
  badgeType String?
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Match {
  id            String   @id @default(cuid())
  userAId       String
  userBId       String
  overlapReason String   // human-readable explanation
  matchScore    Int      @default(0)
  createdAt     DateTime @default(now())

  userA User @relation("MatchUserA", fields: [userAId], references: [id])
  userB User @relation("MatchUserB", fields: [userBId], references: [id])
}
